    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const thread = item.json;\n  const messages = thread.messages || [];\n\n  if (!messages.length) {\n    return {\n      json: {\n        ...thread,\n        reply_message_id: '',\n        reply_thread_id: thread.id || '',\n        reply_ready: false\n      }\n    };\n  }\n\n  // Select the latest message in the Gmail thread\n  const latestMessage = messages.reduce((latest, current) => {\n    return Number(current.internalDate || 0) >\n           Number(latest.internalDate || 0)\n      ? current\n      : latest;\n  });\n\n  return {\n    json: {\n      ...thread,\n      reply_message_id: latestMessage.id || '',\n      reply_thread_id: latestMessage.threadId || thread.id || '',\n      reply_ready: Boolean(latestMessage.id)\n    }\n  };\n});"
      },
