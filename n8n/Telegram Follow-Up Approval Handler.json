    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE job_applications\nSET\n    followup_count = followup_count + 1,\n    last_followup_at = CURRENT_TIMESTAMP,\n\n    next_followup_at =\n        CASE\n            WHEN followup_count + 1 = 1\n                THEN CURRENT_TIMESTAMP + INTERVAL '7 days'\n            WHEN followup_count + 1 = 2\n                THEN CURRENT_TIMESTAMP + INTERVAL '14 days'\n            WHEN followup_count + 1 >= 3\n                THEN NULL\n        END,\n\n    followup_stopped =\n        CASE\n            WHEN followup_count + 1 >= 3 THEN TRUE\n            ELSE FALSE\n        END,\n\n    updated_at = CURRENT_TIMESTAMP\n\nWHERE id = {{ $('Execute a SQL query3').item.json.application_id }}\n\nRETURNING\n    id,\n    company,\n    role,\n    followup_count,\n    last_followup_at,\n    next_followup_at,\n    followup_stopped;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
