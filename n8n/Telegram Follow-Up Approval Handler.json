        "query": "SELECT\n    f.id AS followup_id,\n    f.application_id,\n    f.attempt_number,\n    f.generated_subject,\n    f.generated_body,\n    f.status,\n    j.company,\n    j.role,\n    j.recipient_email,\n    j.recipient_name,\n    j.gmail_thread_id\nFROM followups f\nJOIN job_applications j\n    ON j.id = f.application_id\nWHERE f.application_id = {{ $json.application_id }}\n  AND f.status = 'PENDING'\nORDER BY f.attempt_number DESC\nLIMIT 1;",
