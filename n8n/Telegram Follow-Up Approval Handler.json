    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE job_applications\nSET\n    followup_count = 1,\n    next_followup_at = last_followup_at + INTERVAL '7 days',\n    followup_stopped = FALSE,\n    updated_at = CURRENT_TIMESTAMP\nWHERE id IN (1,2,3,4,5,6)\nRETURNING\n    id,\n    company,\n    role,\n    followup_count,\n    last_followup_at,\n    next_followup_at,\n    followup_stopped;",
